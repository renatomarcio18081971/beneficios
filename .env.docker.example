# Copie para .env.docker e preencha com a connection string do PostgreSQL de testes.
# O arquivo .env.docker não deve ser commitado (contém senha).
#
# DEFAULT_CONNECTION=Host=192.168.18.70;Port=5433;Database=beneficios;Username=postgres;Password=SUA_SENHA;Search Path=beneficios
#
# Antes do primeiro deploy, gere os certificados TLS do gateway:
#   .\scripts\generate-nginx-certs.ps1
#
# DNS interno (obrigatório):
#   *.tresonze.servidor               A  192.168.18.70
#   beneficios.tresonze.servidor      A  192.168.18.70
#   *.beneficios.tresonze.servidor    A  192.168.18.70
#
# Subida na ordem:
#   1. docker compose -f docker-compose.gateway.yml up -d
#   2. docker compose up -d --build
#   3. (registrar-ponto) docker compose up -d --build
#
# URLs (porta 443):
#   Registrar Ponto API:  https://registrar-ponto-api.tresonze.servidor/swagger
#   Beneficios API:       https://beneficios-api.tresonze.servidor/swagger
#   Beneficios admin:     https://beneficios.tresonze.servidor/
#   Beneficios tenant:    https://exemplo.beneficios.tresonze.servidor/

DEFAULT_CONNECTION=
