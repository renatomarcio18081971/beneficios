# Copie para .env.docker e preencha com a connection string do PostgreSQL de testes.
# O arquivo .env.docker não deve ser commitado (contém senha).
#
# DEFAULT_CONNECTION=Host=SEU_HOST;Port=5432;Database=beneficios;Username=SEU_USER;Password=SUA_SENHA;
#
# Antes do primeiro docker compose up, gere os certificados TLS:
#   .\scripts\generate-nginx-certs.ps1
#
# Front + API HTTPS: https://admin.beneficios.servidor/  (configure DNS ou hosts)
# Swagger:            https://admin.beneficios.servidor/swagger/index.html
# Health:             https://admin.beneficios.servidor/health
# HTTP redireciona:   http://192.168.18.70:9081/
#
# Portas 9443/9081 evitam conflito com registrar-ponto (443/9080) no mesmo servidor.

DEFAULT_CONNECTION=
