{
  "$schema": "https://html-validate.org/schemas/config.json",
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-case": ["error", { "style": ["lowercase", "camelcase"] }],
    "no-self-closing": "off",
    "void-style": "off",
    "no-raw-characters": "off",
    "wcag/h63": "off",
    "prefer-tbody": "off"
  }
}
